{
  "manifest_version": 3,
  "name": "Reseller Command Center — Companion Extension",
  "version": "0.6.0",
  "description": "Listens to Reseller Command Center extension jobs to auto-fill Poshmark, Mercari, and Facebook Marketplace listings and scan existing active listings to link them automatically.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://reseller-command-center-black.vercel.app/*",
    "https://*.vercel.app/*",
    "https://i.ebayimg.com/*",
    "https://poshmark.com/*",
    "https://www.mercari.com/*",
    "https://www.facebook.com/*",
    "https://*.supabase.co/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reseller Command Center Companion"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://poshmark.com/*"],
      "js": ["content/dom-helpers.js", "content/poshmark.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.mercari.com/*"],
      "js": ["content/dom-helpers.js", "content/mercari.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["content/dom-helpers.js", "content/facebook.js"],
      "run_at": "document_idle"
    }
  ]
}
